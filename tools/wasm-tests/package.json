{
  "name": "glsmac-wasm-tests",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "build": "node build.mjs && node platform-build.mjs && node thread-runtime-build.mjs && node asset-bridge-build.mjs && node texture-upload-build.mjs && node smac-map-build.mjs",
    "test": "npm run build && node --test --experimental-test-isolation=none --test-timeout=15000 canvas.test.mjs texture-upload.test.mjs platform.test.mjs thread-runtime.test.mjs smac-map.test.mjs",
    "test:app": "node --test app.test.mjs",
    "test:gse": "node gse.test.mjs",
    "test:fast": "python3 ../behavior-tests/fast.py",
    "test:parity": "python3 ../behavior-tests/audit.py",
    "test:known": "python3 ../behavior-tests/fast.py --catalog ../behavior-tests/known-issues.json",
    "test:assets": "node --test assets.test.mjs asset-bridge.test.mjs",
    "test:custom-maps": "node --test custom-maps.test.mjs",
    "test:gameplay": "node --test gameplay.test.mjs",
    "test:game": "node --test game-assets.test.mjs",
    "test:quickstart": "node --test --test-name-pattern=Quick game-assets.test.mjs",
    "test:planet": "node --test --test-name-pattern=Planet game-assets.test.mjs",
    "test:setup": "node --test --test-name-pattern=\"Credits|Planet\" game-assets.test.mjs",
    "test:installer": "node --test installer.test.mjs",
    "test:pages": "node --test pages.test.mjs",
    "test:textures": "node texture-upload-build.mjs && node --test texture-upload.test.mjs",
    "test:maps": "node smac-map-build.mjs && node --test smac-map.test.mjs"
  },
  "devDependencies": {
    "playwright": "1.61.1",
    "pngjs": "7.0.0",
    "webgl-node": "1.6.1"
  }
}
