{
  "name": "glsmac-wasm-tests",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "build": "node build.mjs && node platform-build.mjs && node thread-runtime-build.mjs && node asset-bridge-build.mjs && node texture-upload-build.mjs && node smac-map-build.mjs && node buffer-copy-build.mjs",
    "test": "npm run build && node --test --experimental-test-isolation=none --test-timeout=15000 canvas.test.mjs texture-upload.test.mjs platform.test.mjs thread-runtime.test.mjs smac-map.test.mjs buffer-copy.test.mjs",
    "test:buffers": "node buffer-copy-build.mjs && node --test buffer-copy.test.mjs",
    "test:app": "node --test app.test.mjs",
    "test:gse": "node gse.test.mjs",
    "test:fast": "python3 ../behavior-tests/fast.py",
    "test:technology": "python3 ../behavior-tests/fast.py --suite technology-sources --suite technology-startup",
    "test:parity": "python3 ../behavior-tests/audit.py",
    "test:economy-parity": "python3 ../behavior-tests/economy/run.py",
    "test:ui-discover": "python3 ../behavior-tests/ui/discover.py",
    "test:ui-record": "python3 ../behavior-tests/ui/run.py --record",
    "test:ui-parity": "python3 ../behavior-tests/ui/run.py",
    "test:known": "npm run test:regressions --",
    "test:assets": "node --test assets.test.mjs asset-bridge.test.mjs",
    "test:custom-maps": "node --test custom-maps.test.mjs",
    "test:gameplay": "node --test --test-concurrency=1 gameplay.test.mjs normal-game.test.mjs colony-production.test.mjs land-resources.test.mjs former-work.test.mjs unit-selection.test.mjs unit-activation.test.mjs unit-sentry.test.mjs unit-sentry-activation.test.mjs colony-join.test.mjs base-open.test.mjs base-resource-hud.test.mjs starvation-dialog.test.mjs starvation-mineral.test.mjs starvation-notice-controls.test.mjs base-rename.test.mjs ingame-menus.test.mjs unit-menu-orders.test.mjs unit-menu-context.test.mjs",
    "test:unit-orders": "node --test --test-name-pattern=\"paused Scout orders\" gameplay.test.mjs",
    "test:normal-game": "node --test normal-game.test.mjs",
    "test:colony-production": "node --test colony-production.test.mjs",
    "test:land-resources": "node --test --test-concurrency=1 land-resources.test.mjs",
    "test:former-work": "node --test --test-concurrency=1 former-work.test.mjs",
    "test:game": "node --test game-assets.test.mjs",
    "test:quickstart": "node --test --test-name-pattern=Quick game-assets.test.mjs",
    "test:planet": "node --test --test-name-pattern=Planet game-assets.test.mjs",
    "test:setup": "node --test --test-name-pattern=\"Credits|Planet\" game-assets.test.mjs",
    "test:installer": "node --test installer.test.mjs",
    "test:pages": "node --test pages.test.mjs",
    "test:textures": "node texture-upload-build.mjs && node --test texture-upload.test.mjs",
    "test:maps": "node smac-map-build.mjs && node --test smac-map.test.mjs",
    "test:regressions": "python3 ../behavior-tests/fast.py --suite base-growth-regression --suite combat-rollback-regression --suite faction-retry-regression --suite popup-sound-regression --suite popup-resize-regression",
    "test:nutrient-rules": "node --test --test-concurrency=1 --test-name-pattern=\"Quick Start loads the installed nutrient rule|ordinary startup consumes installed nutrient rules\" gameplay.test.mjs normal-game.test.mjs",
    "test:mineral-rules": "node --test --test-concurrency=1 --test-name-pattern=\"Quick Start loads installed mineral|ordinary startup consumes installed mineral\" gameplay.test.mjs normal-game.test.mjs",
    "test:world-sizes": "node --test --test-concurrency=1 --test-name-pattern=\"Quick Start loads installed world sizes|ordinary startup consumes installed world sizes\" gameplay.test.mjs normal-game.test.mjs",
    "test:dimensions": "node --test --test-concurrency=1 --test-name-pattern=\"custom dimensions load installed text\" normal-game.test.mjs",
    "test:unit-selection": "node --test --test-concurrency=1 unit-selection.test.mjs",
    "test:unit-activation": "node --test --test-concurrency=1 unit-activation.test.mjs",
    "test:unit-sentry": "node --test --test-concurrency=1 unit-sentry.test.mjs",
    "test:unit-sentry-activation": "node --test --test-concurrency=1 unit-sentry-activation.test.mjs",
    "test:colony-join": "node --test --test-concurrency=1 colony-join.test.mjs",
    "test:starvation-dialog": "node --test --test-concurrency=1 starvation-dialog.test.mjs",
    "test:base-open": "node --test --test-concurrency=1 base-open.test.mjs",
    "test:base-resource-hud": "node --test --test-concurrency=1 base-resource-hud.test.mjs",
    "test:starvation-mineral": "node --test --test-concurrency=1 starvation-mineral.test.mjs",
    "test:starvation-notice-controls": "node --test --test-concurrency=1 starvation-notice-controls.test.mjs",
    "test:base-rename": "node --test --test-concurrency=1 base-rename.test.mjs",
    "test:ingame-menus": "node --test --test-concurrency=1 ingame-menus.test.mjs",
    "test:unit-menu-orders": "node --test --test-concurrency=1 unit-menu-orders.test.mjs",
    "test:hot": "python3 ../behavior-tests/lanes.py --lane hot --jobs 2",
    "test:stable": "python3 ../behavior-tests/lanes.py --lane stable --jobs 2",
    "test:lanes": "python3 ../behavior-tests/lanes.py --list",
    "test:hot:browser": "node --test --test-concurrency=1 ingame-menus.test.mjs unit-menu-orders.test.mjs unit-menu-context.test.mjs",
    "test:unit-menu-context-former-sentry": "node --test --test-concurrency=1 unit-menu-context-former-sentry.test.mjs",
    "test:unit-menu-context-colony-sentry": "node --test --test-concurrency=1 unit-menu-context-colony-sentry.test.mjs",
    "test:unit-menu-context-former-hold": "node --test --test-concurrency=1 unit-menu-context-former-hold.test.mjs",
    "test:unit-menu-context": "node --test --test-concurrency=1 unit-menu-context.test.mjs",
    "test:terraform-menu": "node --test terraform-menu.test.mjs",
    "test:colony-found-menu": "node --test --test-concurrency=1 colony-found-menu.test.mjs",
    "test:colony-near": "node --test --test-concurrency=1 colony-near.test.mjs",
    "test:unit-disband": "node --test --test-concurrency=1 unit-disband.test.mjs",
    "test:unit-disband-shortcut": "node --test --test-concurrency=1 unit-disband-shortcut.test.mjs",
    "test:unit-recycling": "node --test --test-concurrency=1 unit-recycling.test.mjs",
    "test:opening-art": "python3 ../behavior-tests/compare.py compare --cases ../behavior-tests/ui/cases/opening-art.json --reference ../behavior-tests/ui/observations/smacx-gog-2.0-opening-art.json --command 'python3 tools/behavior-tests/ui/opening_art_candidate.py' --timeout 240 --report build/artifacts/opening-art-report.json",
    "test:opening-sequence": "python3 ../behavior-tests/compare.py compare --cases ../behavior-tests/ui/cases/opening-sequence.json --reference ../behavior-tests/ui/observations/smacx-gog-2.0-opening-sequence.json --command 'python3 tools/behavior-tests/ui/opening_sequence_candidate.py' --timeout 240 --report build/artifacts/opening-sequence-report.json",
    "test:interface-tour": "python3 ../behavior-tests/compare.py compare --cases ../behavior-tests/ui/cases/interface-tour-synthetic.json --reference ../behavior-tests/ui/observations/smacx-gog-2.0-interface-tour-synthetic.json --command 'python3 tools/behavior-tests/ui/interface_tour_headless.py' --timeout 240 --report build/artifacts/interface-tour-report.json",
    "test:interface-tour:browser": "python3 ../behavior-tests/compare.py compare --cases ../behavior-tests/ui/cases/interface-tour.json --reference ../behavior-tests/ui/observations/smacx-gog-2.0-interface-tour.json --command 'python3 tools/behavior-tests/ui/interface_tour_candidate.py' --timeout 240 --report build/artifacts/interface-tour-browser-report.json",
    "test:pod-landing:browser": "python3 ../behavior-tests/compare.py compare --cases ../behavior-tests/ui/cases/pod-landing.json --reference ../behavior-tests/ui/observations/smacx-gog-2.0-pod-landing.json --command 'python3 tools/behavior-tests/ui/pod_landing_candidate.py' --timeout 240 --report build/artifacts/pod-landing-report.json",
    "bench:popups": "node ../performance/popup-latency.mjs",
    "test:research": "node --test research.test.mjs",
    "test:state-trace": "python3 ../behavior-tests/state_trace/run.py compare",
    "test:state-trace:record": "python3 ../behavior-tests/state_trace/run.py record"
  },
  "devDependencies": {
    "playwright": "1.61.1",
    "pngjs": "7.0.0",
    "webgl-node": "1.6.1"
  }
}
