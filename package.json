{
  "name": "glsmac-scripts",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "scripts:build": "node tools/scripts/build.mjs",
    "scripts:watch": "node tools/scripts/build.mjs --watch",
    "scripts:types": "tsc --noEmit",
    "prescripts:types": "node tools/scripts/contracts.mjs",
    "scripts:lint": "eslint scripts",
    "scripts:format": "prettier --check scripts tools/scripts tools/script-runtime/*.mjs package.json tsconfig.json eslint.config.mjs",
    "scripts:test": "node --test --experimental-test-isolation=none tools/scripts/*.test.mjs",
    "scripts:benchmark": "node tools/scripts/benchmark.mjs"
  },
  "devDependencies": {
    "@jridgewell/trace-mapping": "0.3.31",
    "@swc/core": "1.16.20",
    "@swc/wasm-typescript": "1.16.20",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "oxc-transform": "0.156.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
