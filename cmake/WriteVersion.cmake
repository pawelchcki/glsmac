SET( VERSION "unknown" )
IF ( EXISTS "${SOURCE_DIR}/.git" )
	EXECUTE_PROCESS(
		COMMAND git rev-parse --short HEAD
		WORKING_DIRECTORY "${SOURCE_DIR}"
		OUTPUT_VARIABLE GIT_VERSION OUTPUT_STRIP_TRAILING_WHITESPACE
		ERROR_QUIET RESULT_VARIABLE GIT_RESULT
	)
	IF ( GIT_RESULT EQUAL 0 )
		SET( VERSION "${GIT_VERSION}" )
	ENDIF ()
ELSEIF ( EXISTS "${SOURCE_DIR}/SOURCE_VERSION" )
	FILE( READ "${SOURCE_DIR}/SOURCE_VERSION" VERSION )
	STRING( STRIP "${VERSION}" VERSION )
ENDIF ()
IF ( NOT VERSION MATCHES "^[A-Za-z0-9._+-]+$" )
	MESSAGE( FATAL_ERROR "Invalid source version" )
ENDIF ()
SET( CONTENT "#define GLSMAC_LAST_COMMIT \"${VERSION}\"\n" )
SET( PREVIOUS "" )
IF ( EXISTS "${OUTPUT_FILE}" )
	FILE( READ "${OUTPUT_FILE}" PREVIOUS )
ENDIF ()
IF ( NOT CONTENT STREQUAL PREVIOUS )
	GET_FILENAME_COMPONENT( OUTPUT_DIR "${OUTPUT_FILE}" DIRECTORY )
	FILE( MAKE_DIRECTORY "${OUTPUT_DIR}" )
	FILE( WRITE "${OUTPUT_FILE}" "${CONTENT}" )
ENDIF ()
