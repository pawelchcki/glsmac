OPTION( GLSMAC_NATIVE_ARCH "Tune native Release builds for the build machine" ON )
OPTION( GLSMAC_WARNINGS_AS_ERRORS "Treat first-party compiler warnings as errors" OFF )
SET( GLSMAC_SANITIZER "none" CACHE STRING "Native instrumentation: none, address-undefined, thread" )
SET_PROPERTY( CACHE GLSMAC_SANITIZER PROPERTY STRINGS none address-undefined thread )
# Preserve the old command line spelling while making instrumentation explicit.
IF ( SANITIZER AND GLSMAC_SANITIZER STREQUAL "none" )
	SET( GLSMAC_SANITIZER "address-undefined" )
ENDIF ()
IF ( NOT GLSMAC_SANITIZER MATCHES "^(none|address-undefined|thread)$" )
	MESSAGE( FATAL_ERROR "Invalid GLSMAC_SANITIZER: ${GLSMAC_SANITIZER}" )
ENDIF ()
IF ( NOT GLSMAC_SANITIZER STREQUAL "none" AND ( EMSCRIPTEN OR WIN32 OR NOT CMAKE_CXX_COMPILER_ID MATCHES "^(Clang|GNU|AppleClang)$" ) )
	MESSAGE( FATAL_ERROR "Selected sanitizer requires a supported native Unix Clang/GCC toolchain" )
ENDIF ()

FUNCTION( GLSMAC_CONFIGURE_TARGET TARGET )
	TARGET_COMPILE_FEATURES( ${TARGET} PRIVATE cxx_std_23 )
	SET_TARGET_PROPERTIES( ${TARGET} PROPERTIES CXX_STANDARD_REQUIRED YES CXX_EXTENSIONS NO )
	TARGET_COMPILE_DEFINITIONS( ${TARGET} PRIVATE
		$<$<CONFIG:Debug>:DEBUG=1>
		$<$<CONFIG:FastDebug>:FASTDEBUG=1>
	)
	IF ( CMAKE_CXX_COMPILER_FRONTEND_VARIANT STREQUAL "MSVC" )
		TARGET_COMPILE_OPTIONS( ${TARGET} PRIVATE /W4 $<$<BOOL:${GLSMAC_WARNINGS_AS_ERRORS}>:/WX> )
	ELSE ()
		TARGET_COMPILE_OPTIONS( ${TARGET} PRIVATE -Wall -Wextra
			$<$<BOOL:${GLSMAC_WARNINGS_AS_ERRORS}>:-Werror>
			$<$<OR:$<CONFIG:Debug>,$<CONFIG:FastDebug>>:-g;-O0>
			$<$<OR:$<CONFIG:Portable32>,$<CONFIG:Portable64>>:-O3>
			$<$<AND:$<CONFIG:Release>,$<BOOL:${GLSMAC_NATIVE_ARCH}>,$<NOT:$<BOOL:${EMSCRIPTEN}>>>:-march=native>
		)
	ENDIF ()
	IF ( NOT WIN32 )
		# Explicit -pthread is also needed by Emscripten's shared-memory ABI.
		TARGET_COMPILE_OPTIONS( ${TARGET} PRIVATE -pthread )
		TARGET_LINK_OPTIONS( ${TARGET} PRIVATE -pthread )
	ENDIF ()
	IF ( NOT GLSMAC_SANITIZER STREQUAL "none" )
		IF ( GLSMAC_SANITIZER STREQUAL "address-undefined" )
			SET( INSTRUMENTATION -fsanitize=address,undefined )
		ELSE ()
			SET( INSTRUMENTATION -fsanitize=thread )
		ENDIF ()
		TARGET_COMPILE_OPTIONS( ${TARGET} PRIVATE ${INSTRUMENTATION} -fno-omit-frame-pointer -fno-sanitize-recover=all )
		TARGET_LINK_OPTIONS( ${TARGET} PRIVATE ${INSTRUMENTATION} -fno-sanitize-recover=all )
	ENDIF ()
ENDFUNCTION()

# Portable libraries must share the application's ABI, while the host embedder
# keeps its host architecture. Do not impose our C++ standard or warnings on them.
FUNCTION( GLSMAC_CONFIGURE_VENDOR_ARCHITECTURE DIRECTORY )
	IF ( NOT GLSMAC_ARCH_COMPILE_OPTIONS )
		RETURN()
	ENDIF ()
	GET_PROPERTY( TARGETS DIRECTORY "${DIRECTORY}" PROPERTY BUILDSYSTEM_TARGETS )
	FOREACH( TARGET IN LISTS TARGETS )
		GET_TARGET_PROPERTY( TYPE ${TARGET} TYPE )
		IF ( TYPE MATCHES "^(STATIC_LIBRARY|SHARED_LIBRARY|MODULE_LIBRARY|OBJECT_LIBRARY|EXECUTABLE)$" )
			TARGET_COMPILE_OPTIONS( ${TARGET} PRIVATE ${GLSMAC_ARCH_COMPILE_OPTIONS} )
			TARGET_LINK_OPTIONS( ${TARGET} PRIVATE ${GLSMAC_ARCH_LINK_OPTIONS} )
		ENDIF ()
	ENDFOREACH()
	GET_PROPERTY( SUBDIRECTORIES DIRECTORY "${DIRECTORY}" PROPERTY SUBDIRECTORIES )
	FOREACH( SUBDIRECTORY IN LISTS SUBDIRECTORIES )
		GLSMAC_CONFIGURE_VENDOR_ARCHITECTURE( "${SUBDIRECTORY}" )
	ENDFOREACH()
ENDFUNCTION()
